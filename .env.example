# Environment Variables for Race Director Dashboard

# Firebase Configuration (use same project as -website)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth Endpoint (defaults to production if not set)
VITE_OAUTH_AUTH_URL=https://binghamsundayrunningclub.co.uk/api/auth

# Target -website repo that race results are written to.
# Override these if the repo is moved/renamed — otherwise saving results will fail.
VITE_GITHUB_OWNER=ripixel
VITE_GITHUB_REPO=bingham-sunday-running-club-website
VITE_GITHUB_BRANCH=main
